APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional local-only admin; use a unique email and a strong password.
TEMPLAARA_ADMIN_NAME="Templaara Admin"
TEMPLAARA_ADMIN_EMAIL=
TEMPLAARA_ADMIN_PASSWORD=

# Product presentation and commercial storage must be separate.
PRODUCT_MEDIA_DISK=public
PRODUCT_ARTIFACT_DISK=product_private
PRODUCT_PACKAGE_MAX_KB=256000
PRODUCT_DOCUMENTATION_MAX_KB=25600
# S3-compatible production: product_s3_public / product_s3_private
PRODUCT_STORAGE_ACCESS_KEY_ID=
PRODUCT_STORAGE_SECRET_ACCESS_KEY=
PRODUCT_STORAGE_REGION=us-east-1
PRODUCT_STORAGE_ENDPOINT=
PRODUCT_STORAGE_PATH_STYLE=false
PRODUCT_STORAGE_PRIVATE_BUCKET=
PRODUCT_STORAGE_PUBLIC_BUCKET=
PRODUCT_STORAGE_PUBLIC_URL=

# Checkout remains disabled until a gateway is explicitly configured.
COMMERCE_GATEWAY=disabled
COMMERCE_DEVELOPMENT_ENABLED=false

ENTITLEMENT_TEMPORARY_URLS=false
ENTITLEMENT_URL_MINUTES=5

# Manual payouts: configure approved minimums explicitly in production.
PAYOUT_MINIMUM_INR=
PAYOUT_MINIMUM_USD=
PAYOUT_MINIMUM_EUR=
PAYOUT_MINIMUM_GBP=
# Stable HMAC key; defaults to APP_KEY. Rotation requires a migration strategy.
PAYOUT_IDENTITY_KEY=

# Refund request window: set an explicit approved policy in production.
REFUND_WINDOW_DAYS=

# Private product support attachments; local/S3 private filesystem disk only.
SUPPORT_ATTACHMENT_DISK=product_private
SUPPORT_ATTACHMENT_MAX_KB=10240
SUPPORT_ATTACHMENTS_MAX=5

# Dedicated asynchronous notification delivery; use a supervised worker.
NOTIFICATION_QUEUE_CONNECTION=database
NOTIFICATION_QUEUE=notifications
MAIL_TIMEOUT=30

# Calendar timezone for read-only marketplace analytics (no currency conversion).
MARKETPLACE_REPORTING_TIMEZONE=Asia/Kolkata

# External payments: COMMERCE_GATEWAY=external; use live mode only after deployment verification.
STRIPE_ENABLED=false
STRIPE_MODE=test
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_ENABLED=false
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
COMMERCE_PROVIDER_INR=razorpay
COMMERCE_PROVIDER_USD=stripe
COMMERCE_PROVIDER_EUR=stripe
COMMERCE_PROVIDER_GBP=stripe

# Production-only infrastructure contract; configure in secret management.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
TRUSTED_PROXIES=
PRODUCTION_DB_SCHEMA=public
PRODUCTION_MULTI_NODE=false
# Set UTC on a new production deployment; never reinterpret historical commerce.
DB_TIMEZONE=
DB_SEARCH_PATH=public
CSP_MODE=enforced
CSP_IMAGE_ORIGINS=
# Optional PostgreSQL session budgets (milliseconds); measure exports before enabling.
DB_STATEMENT_TIMEOUT_MS=
DB_LOCK_TIMEOUT_MS=
