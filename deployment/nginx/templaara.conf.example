# Replace domain, certificate and PHP socket after reviewing the deployment.
server {
    listen 80;
    server_name marketplace.example.org;
    return 308 https://marketplace.example.org$request_uri;
}
server {
    listen 443 ssl;
    server_name marketplace.example.org;
    ssl_certificate /etc/ssl/templaara/fullchain.pem;
    ssl_certificate_key /etc/ssl/templaara/privkey.pem;
    root /srv/templaara/current/public;
    index index.php;
    server_tokens off;
    client_max_body_size 530m;
    location / { try_files $uri $uri/ /index.php?$query_string; }
    location ~ /\. { deny all; }
    location ~* ^/(?:vendor|storage/app|bootstrap|config|database|tests)/ { deny all; }
    location ~* ^/build/.*\.(?:js|css|woff2?|png|jpg|svg)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass unix:/run/php/templaara-fpm.sock;
        fastcgi_read_timeout 75s;
        fastcgi_hide_header X-Powered-By;
    }
    location ~ \.php$ { return 404; }
    # Headers on application responses are owned by ResponseSecurity.
    # Phase 19 rejects webhook bodies >64 KiB independently.
    # Restrict Host at the load balancer; overwrite forwarded headers there.
}
