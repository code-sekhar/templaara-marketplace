[Unit]
Description=Templaara notification worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=templaara-web
Group=templaara-web
WorkingDirectory=/srv/templaara/current
ExecStart=/usr/bin/php artisan queue:work database --queue=notifications,default --tries=5 --timeout=45 --sleep=3 --memory=256 --max-time=3600
Restart=always
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/templaara/shared/storage /srv/templaara/shared/bootstrap-cache

[Install]
WantedBy=multi-user.target
